# Pickaly – ortam değişkenleri şablonu
# Bu dosya YALNIZCA değişken adlarını içerir. Gerçek değerler buraya yazılmaz.
# Yerel geliştirme için bu dosyayı .env.local olarak kopyalayıp yerel değerleri girin.
# Ortam başına değerler ve nerede tutuldukları: TECH_STACK.md §13.3
#
# Kural: NEXT_PUBLIC_ önekli değişkenler istemciye gömülür; bunlara asla gizli değer konmaz.
# Kural: SUPABASE_SERVICE_ROLE_KEY bu dosyada ve Vercel'de YER ALMAZ (yalnızca Supabase Edge Functions secrets).
# Kural: Kod içinde ortam değişkenleri yalnızca src/lib/env.ts üzerinden okunur.

# Supabase (local / staging / production için ayrı değerler; production değerleri yerelde KULLANILMAZ)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hata izleme (D-9) – henüz kullanılmıyor
SENTRY_DSN=
# Yalnızca build sırasında, Vercel ortam değişkeni olarak (gizli)
SENTRY_AUTH_TOKEN=

# Uygulama ortamı etiketi: local | staging | production
# Staging arayüzünde "STAGING" etiketi göstermek için kullanılır (TECH_STACK §13.2)
NEXT_PUBLIC_APP_ENV=local

# Yerel veri depoları örnek içerikle başlasın mı (true / boş). Varsayılan boş: yeni hesap içeriksiz başlar.
# Yalnızca veri katmanı Supabase'e geçene kadar geçerlidir.
PICKALY_DEMO_DATA=
