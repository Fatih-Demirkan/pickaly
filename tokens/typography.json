      "$type": "typography",
      "$value": {
        "fontWeight": 600,
        "fontSize": "12px",
        "lineHeight": "16px"
      }
    },
    "micro": {
      "$type": "typography",
      "$value": {
        "fontWeight": 500,
        "fontSize": "10px",
        "lineHeight": "14px",
        "letterSpacing": "0.04em"
      },
      "$description": "Metin kaynakta BÜYÜK HARF yazılır"
    },
    "nav": {
      "$type": "typography",
      "$value": {
        "fontWeight": 600,
        "fontSize": "10px",
        "lineHeight": "14px"
      }
