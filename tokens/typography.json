{
  "$description": "Manrope tipografi ölçeği. Boyutlar Figma text style'larından, satır yükseklikleri RESPONSIVE.md §6.3 kararından (başlık %125, gövde %150, tutar %110). 'laptop' değeri ≥1024 px'de geçerlidir. Kaynak: DESIGN.md §3",
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Manrope" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "type": {
    "display-lg": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "32px", "lineHeight": "40px" }, "laptop": { "fontSize": "36px", "lineHeight": "45px" } },
    "heading-h1": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "28px", "lineHeight": "35px" }, "laptop": { "fontSize": "32px", "lineHeight": "40px" } },
    "heading-h2": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "24px", "lineHeight": "30px" }, "laptop": { "fontSize": "28px", "lineHeight": "35px" } },
    "heading-h3": { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "20px", "lineHeight": "25px" } },
    "heading-h4": { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "18px", "lineHeight": "23px" } },
    "body-lg": { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": "16px", "lineHeight": "24px" } },
    "body-md": { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": "14px", "lineHeight": "21px" } },
    "body-sm": { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": "12px", "lineHeight": "18px" } },
    "label-md": { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "14px", "lineHeight": "21px" } },
    "label-sm": { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "12px", "lineHeight": "18px" } },
    "label-xs": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "10px", "lineHeight": "15px" }, "$description": "Yalnızca nav etiketleri [Karar Ç-11]" },
    "button": { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "14px", "lineHeight": "21px" } },
    "data-lg": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "32px", "lineHeight": "35px" }, "laptop": { "fontSize": "40px", "lineHeight": "44px" } },
    "data-md": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "24px", "lineHeight": "26px" }, "laptop": { "fontSize": "28px", "lineHeight": "31px" } }
  }
}
