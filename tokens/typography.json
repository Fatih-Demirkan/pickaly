{
  "$description": "Geist tipografi ölçeği. Kaynak: DESIGN_SYSTEM.md Part A §A3 + DESIGN_SYSTEM_PICKALY.md §3. Boyutlar breakpoint'e göre değişmez; tek istisna display-balance (laptop+ 48/52, Karar K-3). 'laptop' değeri ≥1024 px'de geçerlidir",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Geist"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "type": {
    "display-balance": {
      "$type": "typography",
      "$value": {
        "fontWeight": 500,
        "fontSize": "44px",
        "lineHeight": "48px",
        "letterSpacing": "-0.02em"
      },
      "laptop": {
        "fontSize": "48px",
        "lineHeight": "52px"
      }
    },
    "display-hero": {
      "$type": "typography",
      "$value": {
        "fontWeight": 400,
        "fontSize": "34px",
        "lineHeight": "40px",
        "letterSpacing": "-0.02em"
      }
    },
    "title-lg": {
      "$type": "typography",
      "$value": {
        "fontWeight": 500,
        "fontSize": "28px",
        "lineHeight": "34px",
        "letterSpacing": "-0.01em"
      }
    },
    "title-md": {
      "$type": "typography",
      "$value": {
        "fontWeight": 600,
        "fontSize": "20px",
        "lineHeight": "26px",
        "letterSpacing": "-0.01em"
      }
    },
    "title-sm": {
      "$type": "typography",
      "$value": {
        "fontWeight": 600,
        "fontSize": "16px",
        "lineHeight": "22px"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "20px"
      }
    },
    "body-strong": {
      "$type": "typography",
      "$value": {
